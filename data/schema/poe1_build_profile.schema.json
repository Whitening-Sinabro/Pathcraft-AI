{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathcraft-ai.local/schema/poe1_build_profile.schema.json",
  "title": "POE1 Build Profile",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_kind",
    "build_id",
    "identity",
    "playstyle",
    "budget_curve",
    "availability",
    "progression",
    "suitability",
    "confidence",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "dataset_kind": {
      "const": "poe1_build_profile"
    },
    "build_id": {
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "playstyle": {
      "$ref": "#/$defs/playstyle"
    },
    "budget_curve": {
      "$ref": "#/$defs/budgetCurve"
    },
    "availability": {
      "$ref": "#/$defs/availability"
    },
    "progression": {
      "$ref": "#/$defs/progression"
    },
    "suitability": {
      "$ref": "#/$defs/suitability"
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "build_name",
        "patch",
        "class_name",
        "ascendancy",
        "main_skill",
        "leveling_skill"
      ],
      "properties": {
        "build_name": {
          "type": "string"
        },
        "patch": {
          "type": "string"
        },
        "class_name": {
          "type": "string"
        },
        "ascendancy": {
          "type": "string"
        },
        "main_skill": {
          "type": "string"
        },
        "leveling_skill": {
          "type": "string"
        },
        "damage_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weapon_preferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "playstyle": {
      "type": "object",
      "required": [
        "input_style",
        "manual_buttons",
        "movement_dependence",
        "aim_requirement"
      ],
      "properties": {
        "input_style": {
          "enum": [
            "0_button",
            "1_click",
            "1_click_plus_movement",
            "2_button",
            "multi_button"
          ]
        },
        "manual_buttons": {
          "type": "integer",
          "minimum": 0
        },
        "movement_dependence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "aim_requirement": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "budgetCurve": {
      "type": "object",
      "required": [
        "entry_cost_divines",
        "comfortable_cost_divines",
        "aspirational_cost_divines",
        "respec_cost_points"
      ],
      "properties": {
        "entry_cost_divines": {
          "type": "number",
          "minimum": 0
        },
        "comfortable_cost_divines": {
          "type": "number",
          "minimum": 0
        },
        "aspirational_cost_divines": {
          "type": "number",
          "minimum": 0
        },
        "respec_cost_points": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": [
        "league_start_viable",
        "ssf_viable",
        "hc_viable",
        "twink_required"
      ],
      "properties": {
        "league_start_viable": {
          "type": "boolean"
        },
        "ssf_viable": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "hc_viable": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "twink_required": {
          "type": "boolean"
        },
        "mandatory_uniques": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mandatory_transfigured_gems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "transitionPoint": {
      "type": "object",
      "required": [
        "stage",
        "main_skill",
        "trigger"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "main_skill": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "required_links": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "required_item": {
          "type": [
            "string",
            "null"
          ]
        },
        "from_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "to_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "campaignStep": {
      "type": "object",
      "required": [
        "stage",
        "main_skill",
        "source"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "stage_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "main_skill": {
          "type": "string"
        },
        "support_links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auras": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "utility": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guard": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "auraStep": {
      "type": "object",
      "required": [
        "stage",
        "source"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "stage_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "auras": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "utility": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guard": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "passiveMilestone": {
      "type": "object",
      "required": [
        "stage",
        "tree_url",
        "source"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "stage_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "tree_url": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "priorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "gearStage": {
      "type": "object",
      "required": [
        "stage",
        "source"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "stage_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "priorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "progression": {
      "type": "object",
      "required": [
        "leveling_confidence",
        "early_mapping_ready",
        "transition_points",
        "campaign_plan",
        "aura_plan",
        "passive_plan",
        "gear_stages"
      ],
      "properties": {
        "leveling_confidence": {
          "enum": [
            "inferred",
            "near_confirmed",
            "confirmed"
          ]
        },
        "early_mapping_ready": {
          "type": "boolean"
        },
        "transition_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transitionPoint"
          }
        },
        "campaign_plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/campaignStep"
          }
        },
        "aura_plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auraStep"
          }
        },
        "passive_plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passiveMilestone"
          }
        },
        "gear_stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gearStage"
          }
        }
      },
      "additionalProperties": false
    },
    "suitability": {
      "type": "object",
      "required": [
        "mapping",
        "bossing",
        "sanctum",
        "heist",
        "expedition",
        "simulacrum"
      ],
      "properties": {
        "mapping": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "bossing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "sanctum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "heist": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "expedition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "simulacrum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "banned_map_mods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pain_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reroll_recommended_over_respec": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": [
        "representative_build_status",
        "source_count"
      ],
      "properties": {
        "representative_build_status": {
          "enum": [
            "confirmed",
            "near_confirmed",
            "hold"
          ]
        },
        "source_count": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidenceItem": {
      "type": "object",
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "enum": [
            "pobb",
            "maxroll",
            "poe_vault",
            "reddit",
            "forum_guide",
            "youtube",
            "manual_curated"
          ]
        },
        "label": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
