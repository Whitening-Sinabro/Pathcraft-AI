      "unique_name": "The Mutable Star"
    },
    {
      "additional_text": "Adherent Cuffs\n1. 94% increased Armour and Energy Shield\n2. Adds 13 to 20 Cold damage to Attacks\n3. +38 to maximum Life\n4. +42% to Fire Resistance\n5. +43% to Lightning Resistance\n6. +13% to Chaos Resistance",
      "inventory_id": "Gloves1",
      "level_interval": [
        1,
        100
      ],
      "slot_x": 0,
      "slot_y": 0
    },
    {
      "additional_text": "Cryptic Leggings\n1. 35% increased Movement Speed\n2. +81 to Armour\n3. +24 to maximum Energy Shield\n4. +141 to maximum Life\n5. +37% to Fire Resistance\n6. +23% to Chaos Resistance\n7. +34% of Armour also applies to Elemental Damage",
      "inventory_id": "Boots1",
      "level_interval": [
        1,
        100
      ],
      "slot_x": 0,
      "slot_y": 0
    },
    {
      "additional_text": "Gold Amulet\n1. +13% to all Elemental Resistances\n2. +92 to maximum Energy Shield\n3. 28% increased maximum Energy Shield\n4. +97 to maximum Life\n5. +3 to Level of all Spell Skills\n6. +5% to Quality of all Skills",
      "inventory_id": "Amulet1",
      "level_interval": [
        1,
        100
      ],
      "slot_x": 0,
      "slot_y": 0
    },
    {
      "additional_text": "Plate Belt\n1. +115 to maximum Life\n2. 20% increased Charm Effect Duration\n3. +19% to Fire Resistance\n4. +38% to Cold Resistance\n5. +33% to Lightning Resistance\n6. +117 to maximum Mana",
      "inventory_id": "Belt1",
      "level_interval": [
        1,
        100
      ],
      "slot_x": 0,
      "slot_y": 0
    },
    {
      "additional_text": "Prismatic Ring\n1. 25% increased Chaos Damage\n2. +87 to maximum Mana\n3. +9% to all Elemental Resistances\n4. +18% to Chaos Resistance\n5. 14.7 Life Regeneration per second\n6. +20% to Maximum Quality",
      "inventory_id": "Ring1",
