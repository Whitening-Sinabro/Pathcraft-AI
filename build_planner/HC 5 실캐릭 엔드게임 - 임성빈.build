  "inventory_slots": [
    {
      "additional_text": "Chiming Staff\n1. 41% increased Cast Speed\n2. 113% increased Flammability Magnitude\n3. Gain 89% of Damage as Extra Chaos Damage\n4. +6 to Level of all Spell Skills\n5. 60% increased Magnitude of Damaging Ailments you inflict\n6. Sanctified",
      "inventory_id": "Weapon1",
      "level_interval": [
        1,
        100
      ],
      "slot_x": 0,
      "slot_y": 0
    },
    {
      "additional_text": "Trarthan Cannon\n1. 39% increased Cooldown Recovery Rate for Grenade Skills\n2. 28% increased effect of Socketed Augment Items\n3. 9% increased Spirit Reservation Efficiency of Skills",
      "inventory_id": "Weapon2",
      "level_interval": [
        1,
        100
      ],
      "slot_x": 0,
      "slot_y": 0
    },
    {
      "additional_text": "Imperial Greathelm\n1. +220 to Armour\n2. 85% increased Armour\n3. +32 to Intelligence\n4. +35% to Fire Resistance\n5. +31% to Cold Resistance\n6. 34% increased Armour\n7. +33 to maximum Life",
      "inventory_id": "Helm1",
      "level_interval": [
