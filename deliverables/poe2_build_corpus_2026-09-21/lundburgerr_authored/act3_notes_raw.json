{
  "variant": {
    "id": "4",
    "title": "Act 3",
    "description": {
      "value": {
        "root": {
          "children": [
            {
              "children": [
                {
                  "detail": 0,
                  "format": 0,
                  "mode": "normal",
                  "style": "",
                  "text": "In act 3 we will unlock Fortifying Cry and Sunder with our first T9 skill gems.",
                  "type": "text",
                  "version": 1
                },
                {
                  "type": "linebreak",
                  "version": 1
                },
                {
                  "detail": 0,
                  "format": 0,
                  "mode": "normal",
                  "style": "",
                  "text": "Exploding the Shield Walls with Fortifying Cry will Boost our damage slightly and give us a little bit of guard.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr",
              "format": "",
              "indent": 0,
              "textFormat": 0,
              "textStyle": "",
              "type": "paragraph",
              "version": 1
            },
            {
              "children": [
                {
                  "detail": 0,
                  "format": 0,
                  "mode": "normal",
                  "style": "",
                  "text": "We use Sunder just to proc Sundered Armour on bosses after we break their armour, this will make the bosses take 40% increased physical damage taken instead of just 20%",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr",
              "format": "",
              "indent": 0,
              "textFormat": 0,
              "textStyle": "",
              "type": "paragraph",
              "version": 1
            }
          ],
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "type": "root",
          "version": 7
        }
      },
      "placeholder": "Describe build variant...",
      "charLimit": 5000
    },
    "childrenIds": [
      "e6e73517-5b67-4424-9d0b-68e0d22acc06",
      "0e0d2b3d-da53-4040-90e4-a4504a300577",
      "0549b66d-7fed-41dd-82c9-884ac259eb0f",
      "9bfe9db8-64b7-478a-8b44-422a3d61cbb7"
    ]
  },
  "widgets": [
    {
      "__typename": "Poe2DocumentUgWidgetEquipmentV1",
