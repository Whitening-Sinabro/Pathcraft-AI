  "skills": [
    {
      "id": "Metadata/Items/Gem/SkillGemAscendancyAncestralSpirits",
      "level_interval": [
        1,
        100
      ],
      "additional_text": "<b>{선대의 혼백 · 자동 부여}\n전직에서 자동 부여. 별도 젬을 만들지 않는다. 토템이 부르는 선조는 주로 보조 효과다.\n<b>{이 스킬 안에 넣을 젬}\n현재 연결 보조 없음."
    },
    {
      "id": "Metadata/Items/Gems/SkillGemPurityOfFire",
      "level_interval": [
        1,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemVitalityTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{활력 II}\n연결할 스킬: 불의 순수함 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemCannibalismTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{식인 II}\n연결할 스킬: 불의 순수함 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gem/SupportGemWarmBlooded",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{따뜻한 피}\n연결할 스킬: 불의 순수함 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        }
      ],
      "additional_text": "<b>{불의 순수함 · 세트 I}\n성소 셉터가 부여한다. 해당 세트의 셉터 스킬에 보조를 연결한다.\n<b>{이 스킬 안에 넣을 젬}\n활력 II + 식인 II + 따뜻한 피\nG 무기 세트에서 I만 체크한다. 파일이 체크박스를 자동 설정하지 않는다."
    },
    {
      "id": "Metadata/Items/Gem/SkillGemShieldBlock",
      "level_interval": [
        1,
        100
      ],
      "additional_text": "<b>{방패 들기 · 세트 I}\n방패 세트에서 막기. 토템 설치 후 이 세트로 복귀한다.\n<b>{이 스킬 안에 넣을 젬}\n현재 연결 보조 없음.\nG 무기 세트에서 I만 체크한다. 파일이 체크박스를 자동 설정하지 않는다."
    },
    {
      "id": "Metadata/Items/Gems/SkillGemHarbingerOfMadness",
      "level_interval": [
        1,
        100
      ],
      "additional_text": "<b>{광기의 선구자 · 자동 부여}\nSadist’s Mercy가 부여한다. 희귀 철퇴에는 없는 선택 항목이다.\n<b>{이 스킬 안에 넣을 젬}\n현재 연결 보조 없음."
    },
    {
      "id": "Metadata/Items/Gems/SkillGemPurityOfFire",
      "level_interval": [
        1,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemVitality",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{활력 I}\n연결할 스킬: 불의 순수함 (세트 II).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemPrecisionTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{정밀함 II}\n연결할 스킬: 불의 순수함 (세트 II).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        }
      ],
      "additional_text": "<b>{불의 순수함 · 세트 II}\n성소 셉터가 부여한다. 해당 세트의 셉터 스킬에 보조를 연결한다.\n<b>{이 스킬 안에 넣을 젬}\n활력 I + 정밀함 II\nG 무기 세트에서 II만 체크한다. 파일이 체크박스를 자동 설정하지 않는다."
    },
    {
      "id": "Metadata/Items/Gem/SkillGemResonatingShield",
      "level_interval": [
        15,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemRage",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{격노 I}\n연결할 스킬: 공명하는 방패 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemDemolisher",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{방어구 철거자 I}\n연결할 스킬: 공명하는 방패 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        }
      ],
      "additional_text": "<b>{공명하는 방패 · 세트 I}\n필요할 때 쓰는 방패 보조 공격. 주력 토템/함성보다 먼저 연타할 필요는 없다.\n<b>{이 스킬 안에 넣을 젬}\n격노 I + 방어구 철거자 I\nG 무기 세트에서 I만 체크한다. 파일이 체크박스를 자동 설정하지 않는다."
    },
    {
      "id": "Metadata/Items/Gem/SkillGemMagmaBarrier",
      "level_interval": [
        11,
        100
      ],
      "additional_text": "<b>{마그마 장벽 · 세트 I}\n정신력 버프. 버프와 연결 보조의 예약량을 합산한다.\n후기 정신력 300 확보가 우선이다. 양 세트의 토템 예약량이 모자라면 이 버프를 먼저 끈다.\n<b>{이 스킬 안에 넣을 젬}\n현재 연결 보조 없음.\nG 무기 세트에서 I만 체크한다. 파일이 체크박스를 자동 설정하지 않는다."
    },
    {
      "id": "Metadata/Items/Gem/SkillGemFortifyingCry",
      "level_interval": [
        32,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemCorruptingCryThree",
          "level_interval": [
            65,
            100
          ],
          "additional_text": "<b>{파콰테의 맹약}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다.\n캐릭터 65레벨 필요. 타락시키는 비명 I와 같은 함성에 함께 넣지 않는다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemEchoingCry",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{메아리치는 함성}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemBrutalityTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{포악함 II}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gem/SupportGemSwiftAfflictionTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{고통 격화 II}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        }
      ],
      "additional_text": "<b>{보강하는 함성 · 세트 I}\n방어도 방패가 있는 I에서 사용한다. 토템 설치 뒤 I로 돌아오는 함성이다.\n파콰테 함성은 한 번 누른 뒤 이동. 메아리는 1.3초 간격 2회, 다음 직접 사용 전에 10미터 이동이 필요하다. 최대 생명력 추가 비용을 기본 비용과 따로 확인한다. 반복까지 회복으로 모두 상쇄된다고 가정하지 않는다.\n<b>{이 스킬 안에 넣을 젬}\n파콰테의 맹약 + 메아리치는 함성 + 포악함 II + 고통 격화 II\nG 무기 세트에서 I만 체크한다. 파일이 체크박스를 자동 설정하지 않는다."
    },
    {
      "id": "Metadata/Items/Gems/SkillGemAncestralWarriorTotem",
      "level_interval": [
        52,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gem/SupportGemAncestralUrgencyThree",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{긴급한 토템 III}\n연결할 스킬: 선대의 전사 토템 (세트 II).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gem/SupportGemBranchingFissures",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{파생하는 균열 I}\n연결할 스킬: 선대의 전사 토템 (세트 II).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemBrutalityThree",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{포악함 III}\n연결할 스킬: 선대의 전사 토템 (세트 II).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        }
      ],
      "additional_text": "<b>{선대의 전사 토템 · 세트 II}\n지면 분쇄 액티브 젬을 반드시 이 토템의 내부 소켓에 넣는다. 아래 일반 보조도 같은 토템에 넣는다. 설치는 II만 체크하고 사용 직후 I로 복귀한다.\n<b>{이 스킬 안에 넣을 젬}\n지면 분쇄 [내부 액티브 젬] + 긴급한 토템 III + 파생하는 균열 I + 포악함 III\nG 무기 세트에서 II만 체크한다. 파일이 체크박스를 자동 설정하지 않는다."
    },
    {
      "id": "Metadata/Items/Gems/SkillGemSeismicCry",
      "level_interval": [
        42,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gem/SupportGemAstralProjection",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{우주의 영사}\n연결할 스킬: 지진 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemInspirationTwo",
          "level_interval": [
