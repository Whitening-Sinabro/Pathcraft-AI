  "skills": [
    {
      "id": "Metadata/Items/Gem/SkillGemAscendancyAncestralSpirits",
      "level_interval": [
        1,
        100
      ],
      "support_skills": [],
      "additional_text": "<b>{선대의 혼백 · 자동 부여}\n전직에서 자동 부여. 별도 젬을 만들지 않는다. 토템이 부르는 선조는 주로 보조 효과다.\n<b>{이 스킬 안에 넣을 젬}\n현재 연결 보조 없음."
    },
    {
