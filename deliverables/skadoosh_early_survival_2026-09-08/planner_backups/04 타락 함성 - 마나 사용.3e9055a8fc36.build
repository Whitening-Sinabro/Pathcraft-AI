  "skills": [
    {
      "id": "Metadata/Items/Gem/SkillGemAscendancyAncestralSpirits",
      "level_interval": [
        1,
        100
      ],
      "additional_text": "<b>{선대의 혼백 · 자동 부여}\n자동 부여 효과. 별도 무기 세트 체크 대상으로 만들지 않는다.\n전직에서 자동 부여. 별도 젬을 만들지 않는다. 토템이 부르는 선조는 주로 보조 효과다.\n<b>{이 스킬 안에 넣을 젬}\n현재 연결 보조 없음."
    },
    {
      "id": "Metadata/Items/Gem/SkillGemShieldBlock",
      "level_interval": [
        1,
        100
      ],
      "additional_text": "<b>{방패 들기 · 세트 I}\nG 무기 세트 체크: I만. 플래너 파일이 실제 체크 상태를 자동 변경하지는 않는다.\n방패 세트에서 막기. 토템 설치 후 이 세트로 복귀한다.\n<b>{이 스킬 안에 넣을 젬}\n현재 연결 보조 없음."
    },
    {
      "id": "Metadata/Items/Gem/SkillGemFortifyingCry",
      "level_interval": [
        32,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemCorruptingCry",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{타락시키는 비명 I}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemBrutalityTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{포악함 II}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gem/SupportGemSwiftAfflictionTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{고통 격화 II}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemInspirationTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{효율 II}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        }
      ],
      "additional_text": "<b>{보강하는 함성 · 세트 I}\nG 무기 세트 체크: I만. 플래너 파일이 실제 체크 상태를 자동 변경하지는 않는다.\n방어도 방패가 있는 I에서 사용한다. 토템 설치 뒤 I로 돌아오는 함성이다.\n<b>{전투에서 누르는 때}\n실제 타락 함성 버튼. 잡몹에 사용 후 이동, 보스에는 토템을 유지하며 타락한 피를 갱신한다. 마나가 줄면 사용 빈도와 플라스크를 확인한다.\n<b>{이 스킬 안에 넣을 젬}\n타락시키는 비명 I + 포악함 II + 고통 격화 II + 효율 II"
    },
    {
      "id": "Metadata/Items/Gem/SkillGemResonatingShield",
      "level_interval": [
        15,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemRage",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{격노 I}\n연결할 스킬: 공명하는 방패 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemDemolisher",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{방어구 철거자 I}\n연결할 스킬: 공명하는 방패 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        }
      ],
      "additional_text": "<b>{공명하는 방패 · 세트 I}\nG 무기 세트 체크: I만. 플래너 파일이 실제 체크 상태를 자동 변경하지는 않는다.\n필요할 때 쓰는 방패 보조 공격. 주력 토템/함성보다 먼저 연타할 필요는 없다.\n<b>{이 스킬 안에 넣을 젬}\n격노 I + 방어구 철거자 I"
    },
    {
      "id": "Metadata/Items/Gems/SkillGemVolcanicFissure",
      "level_interval": [
        23,
        100
      ],
      "additional_text": "<b>{화산 균열 · 세트 I}\nG 무기 세트 체크: I만. 플래너 파일이 실제 체크 상태를 자동 변경하지는 않는다.\n보조 공격. 이 단계의 연결표를 따르고 없는 보조를 다른 스킬에서 임의로 빼지 않는다.\n<b>{이 스킬 안에 넣을 젬}\n현재 연결 보조 없음."
    },
    {
      "id": "Metadata/Items/Gem/SkillGemForgeHammer",
      "level_interval": [
        32,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemJaggedGround",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{요철 지대 I}\n연결할 스킬: 대장간 망치 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gem/SupportGemDomain",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{유지되는 대지 I}\n연결할 스킬: 대장간 망치 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemFistOfWarTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{전쟁의 주먹 II}\n연결할 스킬: 대장간 망치 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        }
      ],
      "additional_text": "<b>{대장간 망치 · 세트 I}\nG 무기 세트 체크: I만. 플래너 파일이 실제 체크 상태를 자동 변경하지는 않는다.\n안전할 때 보조로 사용한다. 요철 지대 I 보조는 인내 충전을 소비하므로 충전 없이 지대가 생긴다고 가정하지 않는다.\n<b>{전투에서 누르는 때}\n토템·함성이 유지되고 보스 패턴에 빈틈이 있을 때 보조 타격. 매 함성마다 반드시 끼워 넣는 순서는 아니다.\n<b>{이 스킬 안에 넣을 젬}\n요철 지대 I + 유지되는 대지 I + 전쟁의 주먹 II"
    },
    {
      "id": "Metadata/Items/Gems/SkillGemEarthquake",
      "level_interval": [
        1,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gem/SupportGemSuffuse",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{잠식하는 지대}\n연결할 스킬: 지진 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gem/SupportGemDomainTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{유지되는 대지 II}\n연결할 스킬: 지진 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        }
      ],
      "additional_text": "<b>{지진 · 세트 I}\nG 무기 세트 체크: I만. 플래너 파일이 실제 체크 상태를 자동 변경하지는 않는다.\n토템을 보조할 요철 지대를 만든다. 방송에서 지대가 나타나지 않는 문제가 있었으므로 실제 바닥 표시를 확인한다.\n<b>{전투에서 누르는 때}\n보스가 머무는 곳에 안전할 때 요철 지대를 보탠다. 토템 설치·함성 갱신·패턴 회피 사이에 쓰는 보조 동작이다.\n<b>{이 스킬 안에 넣을 젬}\n잠식하는 지대 + 유지되는 대지 II\n지대가 실제로 생성되지 않을 때 젬·세트와 지역 변경·재접속을 점검한다. 현재도 항상 발생하는 버그라고 단정하지 않는다."
    },
    {
      "id": "Metadata/Items/Gems/SkillGemBoneshatter",
      "level_interval": [
        1,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemImpactShockwave",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{충돌 충격파}\n연결할 스킬: 뼈 박살 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemInspiration",
          "level_interval": [
