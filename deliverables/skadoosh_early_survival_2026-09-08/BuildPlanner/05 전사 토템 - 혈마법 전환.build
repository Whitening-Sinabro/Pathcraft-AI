  "skills": [
    {
      "id": "Metadata/Items/Gem/SkillGemAscendancyAncestralSpirits",
      "level_interval": [
        1,
        100
      ],
      "support_skills": [],
      "additional_text": "<b>{선대의 혼백 · 자동 부여}\n자동 부여 효과. 별도 무기 세트 체크 대상으로 만들지 않는다.\n전직에서 자동 부여. 별도 젬을 만들지 않는다. 토템이 부르는 선조는 주로 보조 효과다.\n<b>{이 스킬 안에 넣을 젬}\n현재 연결 보조 없음."
    },
    {
      "id": "Metadata/Items/Gems/SkillGemPurityOfFire",
      "level_interval": [
        1,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemVitalityTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{활력 II}\n연결할 스킬: 순수함 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemCannibalismTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{식인 II}\n연결할 스킬: 순수함 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        }
      ],
      "additional_text": "<b>{순수함 · 세트 I}\nG 무기 세트 체크: I만. 플래너 파일이 실제 체크 상태를 자동 변경하지는 않는다.\n성소 셉터가 부여한다. 해당 세트의 셉터 스킬에 보조를 연결한다.\n<b>{이번 단계의 교체·준비}\n표의 활력/식인은 이후 성장 연결이다. 첫 전사 토템 설치 장면에서 양쪽 완성 연결이 모두 갖춰졌다고 확인한 것은 아니다. 각 세트의 회복과 버프 점유 후 남는 정신력을 따로 확인한다.\n<b>{이 스킬 안에 넣을 젬}\n활력 II + 식인 II"
    },
    {
      "id": "Metadata/Items/Gem/SkillGemShieldBlock",
      "level_interval": [
        1,
        100
      ],
      "support_skills": [],
      "additional_text": "<b>{방패 들기 · 세트 I}\nG 무기 세트 체크: I만. 플래너 파일이 실제 체크 상태를 자동 변경하지는 않는다.\n방패 세트에서 막기. 토템 설치 후 이 세트로 복귀한다.\n<b>{이 스킬 안에 넣을 젬}\n현재 연결 보조 없음."
    },
    {
      "id": "Metadata/Items/Gems/SkillGemPurityOfFire",
      "level_interval": [
        1,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemVitality",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{활력 I}\n연결할 스킬: 순수함 (세트 II).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemPrecisionTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{정밀함 II}\n연결할 스킬: 순수함 (세트 II). 해당 스킬의 보조 소켓에 넣는다."
        }
      ],
      "additional_text": "<b>{순수함 · 세트 II}\nG 무기 세트 체크: II만. 해당 셉터 스킬에 연결한다.\n<b>{이번 단계의 교체·준비}\n정밀함 II는 방송 03:36:12에 이미 추가됐다. 07에서 처음 넣는 보조가 아니다. 보조 툴팁의 추가 점유 20을 성소 셉터의 실제 추가 점유로 단정하지 않는다. 9월 9일 방송의 순수함 연결은 단순 합산과 맞지 않으므로, 버프를 켠 뒤 G에서 양 세트의 실제 남는 정신력을 확인한다. 54레벨 진입 즉시 완성 연결이 있었다는 뜻은 아니다.\n<b>{이 스킬 안에 넣을 젬}\n활력 I + 정밀함 II"
    },
    {
      "id": "Metadata/Items/Gem/SkillGemMagmaBarrier",
      "level_interval": [
        1,
        100
      ],
      "support_skills": [],
      "additional_text": "<b>{마그마 장벽 · 세트 I}\nG 무기 세트 체크: I만. 플래너 파일이 실제 체크 상태를 자동 변경하지는 않는다.\n정신력 버프. 버프와 연결 보조의 예약량을 합산한다.\n후기 정신력 300 확보가 우선이다. 양 세트의 토템 예약량이 모자라면 이 버프를 먼저 끈다.\n<b>{이번 단계의 교체·준비}\n04의 명상 II는 제거한다. 혈마법 뒤 마나 재생은 회복 수단이 아니다. 활력은 정신력 여유에 맞춰 해당 세트의 순수함으로 연결한다.\n<b>{이 스킬 안에 넣을 젬}\n현재 연결 보조 없음."
    },
    {
      "id": "Metadata/Items/Gem/SkillGemFortifyingCry",
      "level_interval": [
        1,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemCorruptingCry",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{타락시키는 비명 I}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemBrutalityTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{포악함 II}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gem/SupportGemSwiftAfflictionTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{고통 격화 II}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemInspirationTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{효율 II}\n연결할 스킬: 보강하는 함성 (세트 I).\n해당 스킬의 보조 소켓에 넣는다. 무기의 룬 소켓이 아니다."
        }
      ],
      "additional_text": "<b>{보강하는 함성 · 세트 I}\nG 무기 세트 체크: I만. 플래너 파일이 실제 체크 상태를 자동 변경하지는 않는다.\n방어도 방패가 있는 I에서 사용한다. 토템 설치 뒤 I로 돌아오는 함성이다.\n파콰테 전 단계. 비용이 부담되면 네 번째 효율 II를 확보하고 직접 사용 빈도를 줄인다. 효율 II가 없어도 전환을 강제하지 않는다.\n<b>{전투에서 누르는 때}\n이동 중 잡몹 처리와 시체 폭발에 반복 사용한다. 밀집 무리에는 토템을 추가하고 다시 이 함성으로 I 복귀. 토템 가시도 함께 터뜨리되 가시가 있어야만 함성을 쓰는 것은 아니다. 생명력 비용을 확인한다.\n<b>{이 스킬 안에 넣을 젬}\n타락시키는 비명 I + 포악함 II + 고통 격화 II + 효율 II"
    },
    {
      "id": "Metadata/Items/Gems/SkillGemAncestralWarriorTotem",
      "level_interval": [
        52,
        100
      ],
      "support_skills": [
