  "sha256": "3a720d54459756e33f52c97f44fed9d2093d4eeefe28898f78b16232516df3e6",
  "segments": [
    {
      "start": 0.399,
      "duration": 4.241,
      "text": "안녕하세요. 임성빈입니다. 오늘은"
    },
    {
      "start": 2.72,
      "duration": 4.719,
      "text": "밸런스 패치가 없다는 가정 아래"
    },
    {
      "start": 4.64,
      "duration": 5.72,
      "text": "하드코어 스스프에서 신성의 중제자까지"
    },
    {
      "start": 7.439,
      "duration": 5.16,
      "text": "잡으면서 데미지와 생존 기재의 성능을"
    },
    {
      "start": 10.36,
      "duration": 4.439,
      "text": "검증한 화염파 잼링 빌드 가이드"
    },
    {
      "start": 12.599,
      "duration": 4.44,
      "text": "영상을 들고 왔습니다. 이미 여러"
    },
    {
      "start": 14.799,
      "duration": 4.24,
      "text": "화염파 빌드 가이드가 있지만이"
    },
    {
      "start": 17.039,
      "duration": 4.521,
      "text": "영상만의 차별점이 있으니 영상"
    },
    {
      "start": 19.039,
      "duration": 5.08,
      "text": "시청하시고 좋은 정보 얻어 가세요."
    },
    {
      "start": 21.56,
      "duration": 4.12,
      "text": "추가로 고정 댓글에 상세한 가이드를"
    },
    {
      "start": 24.119,
      "duration": 3.961,
      "text": "작성한 사이트 주소를 올려"
    },
    {
      "start": 25.68,
      "duration": 4.96,
      "text": "두었습니다. 영상 시청 후 한번"
    },
    {
      "start": 28.08,
      "duration": 5.44,
      "text": "보시면 도움이 되실 겁니다. 이처럼"
    },
    {
      "start": 30.64,
      "duration": 5.84,
      "text": "좋은 정보 채널 구독과 영상 좋아요로"
    },
    {
      "start": 33.52,
      "duration": 5.12,
      "text": "놓치지 말고 확인해 보세요."
    },
    {
      "start": 36.48,
      "duration": 5.559,
      "text": "먼저 최종 빌드는 화염파이지만"
    },
    {
      "start": 38.64,
      "duration": 5.84,
      "text": "캠페인은 유탄 스킬들로 진행합니다."
    },
    {
      "start": 42.039,
      "duration": 5.321,
      "text": "이후 52레벨의 화염파를 배워"
    },
    {
      "start": 44.48,
      "duration": 5.48,
      "text": "기름지대를 강력한 점화지대로 만들어"
    },
    {
      "start": 47.36,
      "duration": 5.719,
      "text": "맵과 몬스터들을 불태워 버리는 화염파"
    },
    {
      "start": 49.96,
      "duration": 5.8,
      "text": "빌드로 전환합니다. 개인적으로 저점은"
    },
    {
      "start": 53.079,
      "duration": 4.921,
      "text": "켈라리 바라시타급이라고 생각합니다."
    },
    {
      "start": 55.76,
      "duration": 5.319,
      "text": "그러면서도 고점은 압도적으로 더"
    },
    {
      "start": 58.0,
      "duration": 5.44,
      "text": "높습니다. 저점으로도 신성의 중제자를"
    },
    {
      "start": 61.079,
      "duration": 4.961,
      "text": "무난하게 클리어할 수 있기에 빠르게"
    },
    {
      "start": 63.44,
      "duration": 4.719,
      "text": "아틀라스를 해금하고 최상의 파밍을"
    },
    {
      "start": 66.04,
      "duration": 4.56,
      "text": "진행해 원하시는 최종 빌드로"
    },
    {
      "start": 68.159,
      "duration": 5.161,
      "text": "전환하시면 됩니다. 너무 장점에"
    },
    {
      "start": 70.6,
      "duration": 5.24,
      "text": "대해서만 얘기해 드렸는데 굳이 단점을"
    },
    {
      "start": 73.32,
      "duration": 5.159,
      "text": "찾자면 점화지대 때문에 바닥 패턴이"
    },
    {
      "start": 75.84,
      "duration": 4.319,
      "text": "잘 보이지 않는다는 점과 공중"
    },
    {
      "start": 78.479,
      "duration": 3.96,
      "text": "몬스터를 상대로 회오리 스킬을"
    },
    {
      "start": 80.159,
      "duration": 4.521,
      "text": "사용해야 한다는 점입니다.이"
    },
    {
      "start": 82.439,
      "duration": 5.281,
      "text": "이 두 가지를 제외하면 단점을 꼽기"
    },
    {
      "start": 84.68,
      "duration": 5.24,
      "text": "힘든 화연파 잼링 빌드입니다."
    },
    {
      "start": 87.72,
      "duration": 3.92,
      "text": "캠페인부터 엔드 게임까지 가이드"
    },
    {
      "start": 89.92,
      "duration": 4.72,
      "text": "시작하겠습니다."
    },
    {
      "start": 91.64,
      "duration": 5.92,
      "text": "액트 1장입니다. 무기는 유탄 스킬을"
    },
    {
      "start": 94.64,
      "duration": 5.159,
      "text": "사용하기에 석궁을 장착합니다. 석궁의"
    },
    {
      "start": 97.56,
      "duration": 5.44,
      "text": "피해량이 높을수록 캠페인 난이도가"
    },
    {
      "start": 99.799,
      "duration": 6.241,
      "text": "쉬워지기에 커런시가 부족한 초반 단계"
    },
    {
      "start": 103.0,
      "duration": 5.079,
      "text": "방호구보다 석궁을 강화해 줍니다."
    },
    {
      "start": 106.04,
      "duration": 4.84,
      "text": "이때 옵션은 크게 중요하지 않고"
    },
    {
      "start": 108.079,
      "duration": 5.601,
      "text": "가능한한 많이 구해하시면 됩니다."
    },
    {
      "start": 110.88,
      "duration": 5.519,
      "text": "머리라면 보통 방어도 해피 베이스"
    },
    {
      "start": 113.68,
      "duration": 4.799,
      "text": "방어구를 착용하지만 튕겨내기도 없는"
    },
    {
      "start": 116.399,
      "duration": 5.0,
      "text": "초반 단계에서 해피는 크게 의미가"
    },
    {
      "start": 118.479,
      "duration": 6.0,
      "text": "없습니다. 그래서 이번 빌드는 캠페인"
    },
    {
      "start": 121.399,
      "duration": 4.68,
      "text": "한정 최고의 생존 기재인 방어도와"
    },
    {
      "start": 124.479,
      "duration": 3.24,
      "text": "에너지 보호막 베이스 장비를"
    },
    {
      "start": 126.079,
      "duration": 3.921,
      "text": "장착합니다."
    },
    {
      "start": 127.719,
      "duration": 5.641,
      "text": "무기에 밀려 커런시를 사용하지 못한"
    },
    {
      "start": 130.0,
      "duration": 6.28,
      "text": "방어구에는 하위 육체론으로 최대"
    },
    {
      "start": 133.36,
      "duration": 5.2,
      "text": "생명력을 높이는 것이 좋습니다. 맨"
    },
    {
      "start": 136.28,
      "duration": 4.84,
      "text": "땅에서 장신구는 드롭기만 하면"
    },
    {
      "start": 138.56,
      "duration": 4.2,
      "text": "감사합니다 하면서 아무거나 착용하시면"
    },
    {
      "start": 141.12,
      "duration": 4.04,
      "text": "충분합니다."
    },
    {
      "start": 142.76,
      "duration": 4.92,
      "text": "스킬은 정말 단순합니다."
    },
    {
      "start": 145.16,
      "duration": 5.159,
      "text": "기 및 고유 몬스터에게는 폭발 유탄과"
    },
    {
      "start": 147.68,
      "duration": 5.12,
      "text": "가스 유탄을 번갈아 사용하시고 일반"
    },
    {
      "start": 150.319,
      "duration": 5.801,
      "text": "몬스터는 빠르게 기폭되는 섬광 유탄을"
    },
    {
      "start": 152.8,
      "duration": 6.0,
      "text": "사용하면 됩니다. 끝입니다. 정말"
    },
    {
      "start": 156.12,
      "duration": 5.52,
      "text": "이게 다입니다. 물론 극초반 노강을"
    },
    {
      "start": 158.8,
      "duration": 5.68,
      "text": "잡고 3레벨 스킬잼을 얻기 전까지는"
    },
    {
      "start": 161.64,
      "duration": 5.44,
      "text": "유탄 스킬이 폭발 유탄뿐위기에 화편"
    },
    {
      "start": 164.48,
      "duration": 4.92,
      "text": "탄환도 사용하지만 그 이후로 모든"
    },
    {
      "start": 167.08,
      "duration": 5.079,
      "text": "구간을 유탄 스킬로 수월하게 진행할"
    },
    {
      "start": 169.4,
      "duration": 5.52,
      "text": "수 있습니다. 물론 약간 부족한 범위"
    },
    {
      "start": 172.159,
      "duration": 5.641,
      "text": "데미지를 느낄 수 있지만이는 재전을"
    },
    {
      "start": 174.92,
      "duration": 5.16,
      "text": "사용하면 해결됩니다. 만약 아이템이"
    },
    {
      "start": 177.8,
      "duration": 4.719,
      "text": "따라주지 않아 단일 데미지가 부족하게"
    },
    {
      "start": 180.08,
      "duration": 5.04,
      "text": "느껴지신다면 소모를 사용하시면"
    },
    {
      "start": 182.519,
      "duration": 4.561,
      "text": "됩니다. 지금까지 알려 드린 스킬들의"
    },
    {
      "start": 185.12,
      "duration": 5.24,
      "text": "보조은 다음과 같이 장착하시면"
    },
    {
      "start": 187.08,
      "duration": 5.519,
      "text": "됩니다. 그럼 액트 1장의 최종 보스"
    },
    {
      "start": 190.36,
      "duration": 5.48,
      "text": "지온노 백작을 도전할 때 패시브 트리"
    },
    {
      "start": 192.599,
      "duration": 3.241,
      "text": "보여 드리겠습니다."
    },
    {
      "start": 197.72,
      "duration": 4.04,
      "text": "액트 2장입니다."
    },
    {
      "start": 199.64,
      "duration": 5.319,
      "text": "낮은 아이템 레벨의 장비를 교체하기"
    },
    {
      "start": 201.76,
      "duration": 5.88,
      "text": "위해 광택 나는 석공을 사용합니다."
    },
    {
      "start": 204.959,
      "duration": 5.56,
      "text": "접을 가득 채워두면 데미지는 충분히"
    },
    {
      "start": 207.64,
      "duration": 5.44,
      "text": "사용할 수 있습니다. 이제부터 슬슬"
    },
    {
      "start": 210.519,
      "duration": 5.121,
      "text": "원소 피해가 아프게 들어옵니다."
    },
    {
      "start": 213.08,
      "duration": 5.719,
      "text": "장비에서 원소 저항을 챙기면서 생존을"
    },
    {
      "start": 215.64,
      "duration": 6.48,
      "text": "신경 씁니다. 추가로 갑옷은 퀄리티도"
    },
    {
      "start": 218.799,
      "duration": 5.961,
      "text": "올리면서 최고품질로 만들어 줍니다."
    },
    {
      "start": 222.12,
      "duration": 5.6,
      "text": "액트 2장까지는 육체론으로 최대"
    },
    {
      "start": 224.76,
      "duration": 5.32,
      "text": "생명력을 올리는 편이 좋습니다."
    },
    {
      "start": 227.72,
      "duration": 5.56,
      "text": "당신구는 생명력과 저항을 챙기기 좋은"
    },
    {
      "start": 230.08,
      "duration": 5.48,
      "text": "부위입니다. 두 옵션을 신경 써서"
    },
    {
      "start": 233.28,
      "duration": 4.519,
      "text": "챙겨 주시기 바랍니다."
    },
    {
      "start": 235.56,
      "duration": 5.28,
      "text": "반지의 경우 플랫 데미지를 챙기는"
    },
    {
      "start": 237.799,
      "duration": 4.921,
      "text": "편도 액트를 클리어하는데 도움이 많이"
    },
    {
      "start": 240.84,
      "duration": 4.56,
      "text": "됩니다."
    },
    {
      "start": 242.72,
      "duration": 5.879,
      "text": "스킬에서는 잼링 전직 후 활성화되는"
    },
    {
      "start": 245.4,
      "duration": 5.16,
      "text": "미덕의 정수 어센더시를 제외하고 변경"
    },
    {
      "start": 248.599,
      "duration": 4.36,
      "text": "사항은 없습니다."
    },
    {
      "start": 250.56,
      "duration": 5.6,
      "text": "미덕의 정수의 최대 효율을 위해 비어"
    },
    {
      "start": 252.959,
      "duration": 5.68,
      "text": "있는 스킬 슬롯에 흰민척 기반 스킬을"
    },
    {
      "start": 256.16,
      "duration": 5.039,
      "text": "추가만 해 두시면 됩니다. 스킬의"
    },
    {
      "start": 258.639,
      "duration": 4.921,
      "text": "보조잼은 동일합니다."
    },
    {
      "start": 261.199,
      "duration": 4.321,
      "text": "그럼 액트 2장의 최종 보스 자말라를"
    },
    {
      "start": 263.56,
      "duration": 4.96,
      "text": "도전할 때 패시브 트리를 보여"
    },
    {
      "start": 265.52,
      "duration": 3.0,
      "text": "드리겠습니다."
    },
    {
      "start": 271.24,
      "duration": 5.6,
      "text": "액트 3장과 4장은 뉴탄 빌드의 최고"
    },
    {
      "start": 274.16,
      "duration": 6.24,
      "text": "베이스인 폭격 석궁만 있다면 금방"
    },
    {
      "start": 276.84,
      "duration": 6.359,
      "text": "지나가기에 한 번에 설명드리겠습니다."
    },
    {
      "start": 280.4,
      "duration": 5.639,
      "text": "석궁은 투사체 레벨 옵션이 붙는다면"
    },
    {
      "start": 283.199,
      "duration": 4.961,
      "text": "일단 강화에서 사용하시면 됩니다."
    },
    {
      "start": 286.039,
      "duration": 4.361,
      "text": "접두의 옵션과 티어가 어지간히"
    },
    {
      "start": 288.16,
      "duration": 3.92,
      "text": "망하지만 않는다면 데미지는"
    },
    {
      "start": 290.4,
      "duration": 4.239,
      "text": "충분합니다."
    },
    {
      "start": 292.08,
      "duration": 4.839,
      "text": "방어구의 접두원은 이제 생명력보다"
    },
    {
      "start": 294.639,
      "duration": 4.041,
      "text": "방어도와 에너지 보호막을 올리는 것이"
    },
    {
      "start": 296.919,
      "duration": 4.521,
      "text": "중요합니다."
    },
    {
      "start": 298.68,
      "duration": 5.2,
      "text": "전미어에는 원소 및 카오스 저항과"
    },
    {
      "start": 301.44,
      "duration": 4.24,
      "text": "방어도가 원소 피에도 적용 옵션을"
    },
    {
      "start": 303.88,
      "duration": 4.72,
      "text": "추천드립니다."
    },
    {
      "start": 305.68,
      "duration": 6.28,
      "text": "접두어에서 방어도와 에너지 보호막을"
    },
    {
      "start": 308.6,
      "duration": 5.439,
      "text": "챙기는만큼 룬 몇시 천으로 장착해서"
    },
    {
      "start": 311.96,
      "duration": 4.239,
      "text": "효율을 높힙니다."
    },
    {
      "start": 314.039,
      "duration": 4.641,
      "text": "그리고이 구간에서 PO2 최고의"
    },
    {
      "start": 316.199,
      "duration": 5.881,
      "text": "방어구 중 하나인 변의하는 별"
    },
    {
      "start": 318.68,
      "duration": 5.239,
      "text": "성직자의 법위를 장착할 수 있습니다."
    },
    {
      "start": 322.08,
      "duration": 4.64,
      "text": "어떻게든 구하게 되신다면"
    },
    {
      "start": 323.919,
      "duration": 4.921,
      "text": "축하드립니다. 15등급까지 프리패스"
    },
    {
      "start": 326.72,
      "duration": 4.56,
      "text": "하시면 됩니다."
    },
    {
      "start": 328.84,
      "duration": 4.68,
      "text": "장신구에서는 슬슬 카오스 피해도"
    },
    {
      "start": 331.28,
      "duration": 5.039,
      "text": "아프게 들어오기 시작하므로 카오스"
    },
    {
      "start": 333.52,
      "duration": 5.16,
      "text": "정을 챙겨 주시는 것도 좋습니다."
    },
    {
      "start": 336.319,
      "duration": 4.121,
      "text": "또 플라스크의 접도어도이 시점부터"
    },
    {
      "start": 338.68,
      "duration": 4.2,
      "text": "중요해집니다."
    },
    {
      "start": 340.44,
      "duration": 5.0,
      "text": "접도 옵션 중 회복량 50%"
    },
    {
      "start": 342.88,
      "duration": 5.2,
      "text": "감소하지만 즉시 회복 옵션이"
    },
    {
      "start": 345.44,
      "duration": 5.36,
      "text": "존재합니다. 빠르게 생명력이 떨어질"
    },
    {
      "start": 348.08,
      "duration": 5.64,
      "text": "때 즉각적인 회복은 생존에 큰 도움을"
    },
    {
      "start": 350.8,
      "duration": 5.119,
      "text": "줍니다. 액트 3장과 4장에서 얻은"
    },
    {
      "start": 353.72,
      "duration": 4.0,
      "text": "주얼로 오브로 소켓을 늘려 추가한"
    },
    {
      "start": 355.919,
      "duration": 3.481,
      "text": "보조잼입니다."
    },
    {
      "start": 357.72,
      "duration": 3.919,
      "text": "그럼 유탄을 사용하는 마지막"
    },
    {
      "start": 359.4,
      "duration": 6.0,
      "text": "패시브트리 보여 드리면서 화염파"
    },
    {
      "start": 361.639,
      "duration": 3.761,
      "text": "빌드로 전환해 보겠습니다."
    },
    {
      "start": 367.919,
      "duration": 4.601,
      "text": "이제 막감부터 본격적으로 화염파"
    },
    {
      "start": 369.919,
      "duration": 5.521,
      "text": "빌드로 전환하실 텐데요. 빌드가"
    },
    {
      "start": 372.52,
      "duration": 4.92,
      "text": "돌아가는 방식은 다음과 같습니다."
    },
    {
      "start": 375.44,
      "duration": 5.24,
      "text": "적에게 기름 유탄을 발사해 기름"
    },
    {
      "start": 377.44,
      "duration": 6.4,
      "text": "지대를 생성하고 화염파 최대 집중으로"
    },
    {
      "start": 380.68,
      "duration": 5.359,
      "text": "강력한 점화 지대를 생성합니다."
    },
    {
      "start": 383.84,
      "duration": 4.96,
      "text": "이후 기름 유탄으로 점화 지대를 넓혀"
    },
    {
      "start": 386.039,
      "duration": 5.88,
      "text": "가면서 맵 전체를 불바다로 만들시면"
    },
    {
      "start": 388.8,
      "duration": 4.839,
      "text": "됩니다. 가끔 공중 몬스터가 나올 때"
    },
    {
      "start": 391.919,
      "duration": 4.56,
      "text": "회오리 스킬만 추가로 사용하시면"
    },
    {
      "start": 393.639,
      "duration": 5.321,
      "text": "됩니다. 단 회오리를 사용할 때"
    },
    {
      "start": 396.479,
      "duration": 5.681,
      "text": "주변에 화염파로 인한 강한 점화지대가"
    },
    {
      "start": 398.96,
      "duration": 5.6,
      "text": "아닌 약한 점화지대가 존재한다면"
    },
    {
      "start": 402.16,
      "duration": 4.72,
      "text": "회오리에 약한 점화 피해가 붙어서"
    },
    {
      "start": 404.56,
      "duration": 5.079,
      "text": "이후 생성되는 점화지대는 약해질 수가"
    },
    {
      "start": 406.88,
      "duration": 5.319,
      "text": "있습니다.이 점 유의하면서 빌드를"
    },
    {
      "start": 409.639,
      "duration": 4.801,
      "text": "변경해 보겠습니다. 여기서 하나 더"
    },
    {
      "start": 412.199,
      "duration": 4.601,
      "text": "확인하실 부분이 있습니다. 바로"
    },
    {
      "start": 414.44,
      "duration": 4.8,
      "text": "패시브 트리를 전환하기 위해서는 많은"
    },
    {
      "start": 416.8,
      "duration": 4.44,
      "text": "골드가 필요하다는 점입니다."
    },
    {
      "start": 419.24,
      "duration": 4.6,
      "text": "그러니 최소 10만 골드 정도를"
    },
    {
      "start": 421.24,
      "duration": 4.959,
      "text": "확보하시면 막힘김없이 패시브 트리를"
    },
    {
      "start": 423.84,
      "duration": 4.96,
      "text": "전환할 수 있습니다."
    },
    {
      "start": 426.199,
      "duration": 4.921,
      "text": "또 갑자기 화염파를 위한 좋은 옵션의"
    },
    {
      "start": 428.8,
      "duration": 5.119,
      "text": "지팡이를 구하기가 어려울 수 있으니"
    },
    {
      "start": 431.12,
      "duration": 4.799,
      "text": "미리미리 화염 베이스 지팡이 또는"
    },
    {
      "start": 433.919,
      "duration": 4.921,
      "text": "차인벨 지팡이를 구해 두시면 빠른"
    },
    {
      "start": 435.919,
      "duration": 5.321,
      "text": "전환에 도움이 됩니다."
    },
    {
      "start": 438.84,
      "duration": 4.68,
      "text": "장비는 엔드 게임을 기준으로 설정해"
    },
    {
      "start": 441.24,
      "duration": 5.56,
      "text": "둬서 비행의 법령 고대 레깅스가"
    },
    {
      "start": 443.52,
      "duration": 5.399,
      "text": "보이는데 해당 장비를 구하기 전까지는"
    },
    {
      "start": 446.8,
      "duration": 5.72,
      "text": "방어도 에너지 보호막 베이스의 장화를"
    },
    {
      "start": 448.919,
      "duration": 3.601,
      "text": "착용하시면 됩니다."
    },
    {
      "start": 454.24,
      "duration": 4.359,
      "text": "다음은 엔드 게임까지 가져갈 스킬과"
    },
    {
      "start": 456.52,
      "duration": 4.28,
      "text": "보조잼입니다."
    },
    {
      "start": 458.599,
      "duration": 4.72,
      "text": "범위와 유탄을 담당할 무기 1번"
    },
    {
      "start": 460.8,
      "duration": 5.04,
      "text": "세트와 데미지를 담당할 무기 2번"
    },
    {
      "start": 463.319,
      "duration": 5.121,
      "text": "세트로 나뉘어 있습니다."
    },
    {
      "start": 465.84,
      "duration": 5.639,
      "text": "무기 1번 세트는 기름 유탄 회오리를"
    },
    {
      "start": 468.44,
      "duration": 5.439,
      "text": "지정하시고 화염파을 무기 2번 세트에"
    },
    {
      "start": 471.479,
      "duration": 6.201,
      "text": "지정하시면 됩니다."
    },
    {
      "start": 473.879,
      "duration": 7.081,
      "text": "각 스킬의 보조은 다음과 같습니다."
    },
    {
      "start": 477.68,
      "duration": 5.959,
      "text": "여기서 꿀팁은 미덕의 정수 어센던시의"
    },
    {
      "start": 480.96,
      "duration": 5.72,
      "text": "최대 활용을 위해 강화된 육체가"
    },
    {
      "start": 483.639,
      "duration": 5.921,
      "text": "할당된 목걸리와 무보석 반지 두 개를"
    },
    {
      "start": 486.68,
      "duration": 4.639,
      "text": "착용하시면 추가네 개의 스킬을 장착할"
    },
    {
      "start": 489.56,
      "duration": 4.24,
      "text": "수 있습니다."
    },
    {
      "start": 491.319,
      "duration": 5.041,
      "text": "사용하지 않는네 개 스킬을 추가 스킬"
    },
    {
      "start": 493.8,
      "duration": 4.839,
      "text": "슬롯 가장 아래에 넣으시고 원래"
    },
    {
      "start": 496.36,
      "duration": 4.799,
      "text": "아이템으로 다시 장착하셔도 스킬이"
    },
    {
      "start": 498.639,
      "duration": 5.321,
      "text": "해제되지 않고 그대로 있습니다."
    },
    {
      "start": 501.159,
      "duration": 6.48,
      "text": "마찬가지로 보조잼을 장착해 마석징"
    },
    {
      "start": 503.96,
      "duration": 5.679,
      "text": "어센던시를 활용할 수 있습니다."
    },
    {
      "start": 507.639,
      "duration": 6.84,
      "text": "100레벨 기술 패시 배트리를 준비해"
    },
    {
      "start": 509.639,
      "duration": 4.84,
      "text": "뒀으니 보시고 따라가시면 됩니다."
    },
    {
      "start": 517.959,
      "duration": 5.161,
      "text": "단단하면서도 강력한 화염파 잼링"
    },
    {
      "start": 520.08,
      "duration": 5.56,
      "text": "빌드를 즐기실 수 있을 겁니다. 사실"
    },
    {
      "start": 523.12,
      "duration": 4.08,
      "text": "화염파 잼링 빌드는 기름 유탄의 스킬"
    },
    {
      "start": 525.64,
      "duration": 3.16,
      "text": "설명과 다르게 너무 강력한"
    },
    {
      "start": 527.2,
      "duration": 3.56,
      "text": "상태입니다."
    },
    {
      "start": 528.8,
      "duration": 4.92,
      "text": "언제든 패치 한 번에 사용하지 못할"
    },
    {
      "start": 530.76,
      "duration": 5.199,
      "text": "성능으로 바뀔 수 있어서 추가 패치를"
    },
    {
      "start": 533.72,
      "duration": 3.84,
      "text": "기다리다가 빌드업 가이드 영상 제작이"
    },
    {
      "start": 535.959,
      "duration": 3.601,
      "text": "늦어졌습니다."
    },
    {
      "start": 537.56,
      "duration": 4.48,
      "text": "하지만 화염파보다 급한 패치도 있는"
    },
    {
      "start": 539.56,
      "duration": 4.08,
      "text": "마당에 이것까지 신경 썼을까 싶기도"
    },
    {
      "start": 542.04,
      "duration": 3.76,
      "text": "하네요."
    },
    {
      "start": 543.64,
      "duration": 4.92,
      "text": "그럼 고정 댓글에 달아둔 사이트에"
    },
    {
      "start": 545.8,
      "duration": 4.52,
      "text": "들어가셔서 빌드 파일 다운로드 후"
    },
    {
      "start": 548.56,
      "duration": 4.6,
      "text": "게임 내에서 편하게 세팅을 맞춰"
    },
    {
      "start": 550.32,
      "duration": 4.56,
      "text": "보세요. 도움 되시길 바라며 추가"
    },
    {
      "start": 553.16,
      "duration": 3.56,
      "text": "밸런스 패치 내용이 나오면 정리해서"
    },
    {
      "start": 554.88,
      "duration": 3.36,
      "text": "찾아뵙겠습니다."
    },
    {
      "start": 556.72,
      "duration": 5.6,
      "text": "오플런 라이브 함께 해 주시길"
    },
    {
      "start": 558.24,
      "duration": 4.08,
      "text": "바라면서 시청해 주셔서 감사합니다."
    }
  ]
}