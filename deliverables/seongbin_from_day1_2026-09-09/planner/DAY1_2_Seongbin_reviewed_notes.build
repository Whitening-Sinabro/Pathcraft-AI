      "slot_y": 0
    },
    {
      "additional_text": "Martyr Crown\n1. +9 to Armour\n2. +5 to maximum Energy Shield\n3. 15% increased Armour and Energy Shield\n4. +14% of Armour also applies to Elemental Damage",
      "inventory_id": "Helm1",
      "level_interval": [
        28,
        100
      ],
