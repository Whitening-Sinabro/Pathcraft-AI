  "skills": [
    {
      "id": "Metadata/Items/Gem/SkillGemAscendancyAncestralSpirits",
      "level_interval": [
        1,
        100
      ],
      "additional_text": "<b>{선대의 혼백 · 자동 부여}\n전직에서 자동으로 부여한다. 별도 젬을 제작하지 않는다.\n<b>{이 스킬 안에 넣을 젬}\n현재 단계 연결 보조 없음."
    },
    {
      "id": "Metadata/Items/Gem/SkillGemShieldBlock",
      "level_interval": [
        1,
        100
      ],
      "additional_text": "<b>{방패 들기 · 세트 I}\n방패 세트 I에서 사용한다.\n<b>{이 스킬 안에 넣을 젬}\n현재 단계 연결 보조 없음.\nG의 무기 세트 체크는 직접 지정한다."
    },
    {
      "id": "Metadata/Items/Gems/SkillGemShockwaveTotem",
      "level_interval": [
        7,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemMartialTempo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{빠른 공격 I}\n연결할 스킬: 충격파 토템 (세트 II)\n이 스킬의 1번째 보조 위치에 넣는다."
        },
        {
          "id": "Metadata/Items/Gem/SupportGemAncestralUrgency",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{긴급한 토템 I}\n연결할 스킬: 충격파 토템 (세트 II)\n이 스킬의 2번째 보조 위치에 넣는다."
        },
        {
          "id": "Metadata/Items/Gems/SupportGemBrutalityTwo",
          "level_interval": [
            1,
            100
          ],
          "additional_text": "<b>{포악함 II}\n연결할 스킬: 충격파 토템 (세트 II)\n이 스킬의 3번째 보조 위치에 넣는다."
        }
      ],
      "additional_text": "<b>{충격파 토템 · 세트 II}\n적 앞에 설치하고 방패 I로 돌아온다. 지진의 요철 지대를 함께 이용한다.\n<b>{이 스킬 안에 넣을 젬}\n1. 빠른 공격 I\n2. 긴급한 토템 I\n3. 포악함 II\nG의 무기 세트 체크는 직접 지정한다."
    },
    {
      "id": "Metadata/Items/Gem/SkillGemResonatingShield",
      "level_interval": [
        15,
        100
      ],
      "support_skills": [
        {
          "id": "Metadata/Items/Gems/SupportGemRage",
          "level_interval": [
